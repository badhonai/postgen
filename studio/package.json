{
  "name": "postgen-studio",
  "version": "2.0.0",
  "private": true,
  "description": "Frame-driven motion graphics studio (Remotion) that lives inside the PostGen repo: voice first, picture follows, finished video becomes a PostGen post.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "new": "node tools/new-project.mjs",
    "list": "node tools/motion.mjs list",
    "studio": "node tools/motion.mjs studio",
    "still": "node tools/motion.mjs still",
    "render": "node tools/motion.mjs render",
    "qa": "node tools/motion.mjs qa",
    "doctor": "node tools/doctor.mjs",
    "check": "node tools/check-repo.mjs",
    "typecheck": "tsc --noEmit",
    "build:check": "node tools/motion.mjs bundle starter",
    "test": "node --test tests/*.test.mjs",
    "voice": "node tools/postgen/voice.mjs",
    "cleanup": "node tools/postgen/cleanup.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/badhonai/postgen.git",
    "directory": "studio"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/fonts": "4.0.542",
    "framer-motion": "12.23.24",
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.9.3"
  }
}
