  "segments": [
    {
      "text": "Fluton doesn't keep balances.",
      "start": 0,
      "end": 1.846
    },
    {
      "text": "It keeps notes.",
      "start": 1.846,
      "end": 3.204
    },
    {
      "text": "Each note is a sealed commitment, one leaf in a single tree: the amount, the owner and the token all hidden.",
      "start": 3.204,
      "end": 11.238
    },
    {
      "text": "To spend, you destroy a note and create three new ones.",
      "start": 11.238,
      "end": 15.081
    },
    {
      "text": "The chain learns one thing: a nullifier, proving it's spent without saying which.",
      "start": 15.081,
      "end": 21.281
    },
    {
      "text": "Only the net amount crossing the pool is public.",
      "start": 21.281,
      "end": 24.358
    },
    {
      "text": "Everything inside stays sealed.",
      "start": 24.358,
      "end": 26.889
    }
  ],
