{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "system/**/*.ts",
    "system/**/*.tsx",
    "templates/**/*.ts",
    "templates/**/*.tsx",
    "projects/**/*.ts",
    "projects/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "local",
    ".cache"
  ]
}
