{
  "name": "postgen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.functions.json",
    "pages:dev": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "typecheck:app": "tsc -b",
    "studio:install": "npm --prefix studio install",
    "studio:list": "npm --prefix studio run list",
    "studio:doctor": "npm --prefix studio run doctor",
    "studio:render": "npm --prefix studio run render",
    "studio:qa": "npm --prefix studio run qa",
    "studio:still": "npm --prefix studio run still",
    "studio:cleanup": "npm --prefix studio run cleanup",
    "studio:check": "npm --prefix studio run check",
    "studio:test": "npm --prefix studio run test",
    "studio:ship": "npm --prefix studio run ship",
    "studio:claim": "npm --prefix studio run claim",
    "studio:pack": "npm --prefix studio run pack",
    "studio:import": "npm --prefix studio run import"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.104.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.86.0",
    "ws": "^8.22.0"
  }
}
