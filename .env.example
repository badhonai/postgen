# ── Client (safe to expose) ──────────────────────────────────────────────
# Copy this file to .env and fill in from your Supabase project settings.
# On new projects the "anon key" is the PUBLISHABLE key (sb_publishable_…);
# the legacy anon JWT also works.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY

# ── Server only (Cloudflare Pages → Settings → Environment variables) ────
# NEVER commit real values. NEVER prefix with VITE_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# The project SECRET key (sb_secret_…); legacy service_role JWT also works.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_KEY
# JWT minting for agents (M4) — private JWK JSON of an IMPORTED signing key
# (generate: `supabase gen signing-key`, import: Dashboard → Auth → JWT Keys).
SUPABASE_JWT_SIGNING_KEY={"kty":"EC","kid":"...","...":"..."}
# Optional fallback: only if your project still exposes the legacy HS256
# JWT secret. New projects use signing keys — see PLAN.md §6.
# SUPABASE_JWT_SECRET=

# ── GitHub Actions (repo secrets, used by keepalive.yml) ─────────────────
# SUPABASE_URL
# SUPABASE_ANON_KEY
